PORT=5050
MONGO_DB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/?retryWrites=true&w=majority

# Better Auth
BETTER_AUTH_SECRET=generate-a-long-random-string
BETTER_AUTH_URL=http://localhost:5050
CLIENT_URL=http://localhost:3000

# ======================
# STRIPE
# ======================
# 1. Create account at https://dashboard.stripe.com
# 2. Developers - API keys - copy Secret key (starts with sk_test_)
STRIPE_SECRET_KEY=

# Optional: webhook signing secret (for production webhooks)
STRIPE_WEBHOOK_SECRET=

# ======================
# STRIPE PRICE IDs (optional but recommended)
# ======================
# Dashboard - Products - create product - add recurring monthly price
# Copy Price ID (starts with price_)
# If empty, server falls back to dynamic price_data from plan.price
STRIPE_PRICE_SEEKER_PRO=
STRIPE_PRICE_SEEKER_PREMIUM=
STRIPE_PRICE_RECRUITER_GROWTH=
STRIPE_PRICE_RECRUITER_ENTERPRISE=
