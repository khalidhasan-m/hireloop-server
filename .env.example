PORT=5050
MONGO_DB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/?retryWrites=true&w=majority

# Better Auth
BETTER_AUTH_SECRET=generate-a-long-random-string
BETTER_AUTH_URL=http://localhost:5050
CLIENT_URL=http://localhost:3000

# ======================
# STRIPE
# ======================
# 1. Create account at https://dashboard.stripe.com
# 2. Developers - API keys - copy Secret key (starts with sk_test_)
# 3. ⚠️ This MUST be a real key. The templates below (containing YOUR_) are
#    rejected by the Stripe API with "Invalid API Key provided".
# Test the server config after filling it in: node scripts/stripe-check.js
STRIPE_SECRET_KEY=

# Optional: for production webhooks only. The client-only "confirm" flow used
# during testing does NOT require webhooks.
STRIPE_WEBHOOK_SECRET=

# ======================
# STRIPE PRICE IDs (recommended)
# ======================
# Dashboard - Products - create product - add recurring monthly price
# Copy Price ID (starts with price_)
# If empty, server falls back to dynamic price_data from plan.price
#
# You can create all four prices automatically with your test key:
#   node scripts/setup-stripe-prices.js
# (it creates: HireLoop Pro $19/mo, Premium $39/mo, Growth $49/mo, Enterprise $149/mo)
STRIPE_PRICE_SEEKER_PRO=
STRIPE_PRICE_SEEKER_PREMIUM=
STRIPE_PRICE_RECRUITER_GROWTH=
STRIPE_PRICE_RECRUITER_ENTERPRISE=

# Optional application-status email notifications via Resend
RESEND_API_KEY=
EMAIL_FROM=HireLoop <notifications@your-domain.com>

# Local development uploads are stored in ./uploads and served from /uploads.
# For production, replace this with durable object storage or Cloudinary.
UPLOAD_MAX_MB=5

# Interaction APIs: notifications and interviews are stored in MongoDB collections
# notifications and interviews; no extra environment variables are required.
